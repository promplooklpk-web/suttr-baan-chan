{
  "expo": {
    "name": "สูตรบ้านฉัน",
    "slug": "suttr-baan-chan",
    "owner": "yanyonglpk",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6a44120e-b934-4c78-a6a3-902c410cbae4"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suttrbaanchan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0D0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E0D0C",
          "imageWidth": 280,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E0D0C"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "แอปต้องการเข้าถึงรูปภาพเพื่อแนบรูปสูตรอาหาร"
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6a44120e-b934-4c78-a6a3-902c410cbae4"
      }
    }
  }
}
